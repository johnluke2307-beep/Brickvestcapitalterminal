# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# Secrets panel / Hugging Face "Variables and secrets". Never commit the real file.

# --- Alpaca credentials (paper keys start with "PK") -------------------------
ALPACA_API_KEY = "PK…"
ALPACA_SECRET_KEY = "…"
ALPACA_PAPER = "true"          # keep "true" until the strategy has a track record

# --- Market data feeds -------------------------------------------------------
ALPACA_OPTIONS_FEED = "indicative"   # free tier; "opra" with a paid subscription
ALPACA_STOCK_FEED = "iex"            # free tier; "sip" with a paid subscription

# --- Strategy ----------------------------------------------------------------
BVC_UNIVERSE = "SPY,QQQ,IWM,DIA,XLF,EEM,GLD,TLT"
BVC_STRATEGY = "short_put"     # or "put_credit_spread" (needs options level 3)
BVC_TARGET_DTE = "45"
BVC_TARGET_DELTA = "0.30"
BVC_MIN_IV_RANK = "50"
BVC_PROFIT_TARGET_PCT = "0.50"
BVC_STOP_LOSS_MULTIPLE = "2.00"
BVC_TIME_EXIT_DTE = "21"

# --- Risk guardrails ---------------------------------------------------------
BVC_MAX_MARGIN_UTIL = "0.50"   # hard ceiling on maintenance margin / equity
BVC_MAX_OPEN_POSITIONS = "6"
BVC_MAX_NEW_PER_DAY = "2"
BVC_CONTRACTS_PER_TRADE = "1"
BVC_MIN_EQUITY_USD = "2000"
BVC_DRY_RUN = "false"          # "true" scans and logs without sending orders

# --- Income target -----------------------------------------------------------
BVC_MONTHLY_TARGET_ZAR = "10000"
BVC_FALLBACK_USD_ZAR = "18.50" # used only if every live FX source is unreachable
BVC_LOOP_INTERVAL = "300"      # seconds between bot cycles
